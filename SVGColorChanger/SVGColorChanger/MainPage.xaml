<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="mainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SVGColorChanger"
             x:Class="SVGColorChanger.MainPage"
             BackgroundColor="#1f1f1f">

    <Grid ColumnDefinitions="3*, 2*">
        <Grid Padding="5"
              RowDefinitions="*, 50">
            <Grid>
                <CollectionView x:Name="ColorChangesCollectionView"
                                ItemsSource="{Binding ColorChanges}" >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="4*, *, 4*, *">
                                <Entry Grid.Column="0" 
                                       Placeholder="Press to type"
                                       ClassId="{Binding FromEntryID}"
                                       TextChanged="OnTextChanged"
                                       MaxLength="7" />
                                
                                <BoxView Grid.Column="1"
                                         Color="{Binding FromColor}" />

                                <Entry Grid.Column="2" 
                                       Placeholder="Press to type"
                                       ClassId="{Binding ToEntryID}"
                                       TextChanged="OnTextChanged"
                                       MaxLength="7" />
                                
                                <BoxView Grid.Column="3" 
                                         Color="{Binding ToColor}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*, *">
                <Button Text="Add color change" 
                        WidthRequest="175"
                        HorizontalOptions="End"
                        BackgroundColor="#ac99ea"
                        TextColor="#242424"
                        Clicked="OnAddColorButtonClicked" />

                <Button Grid.Column="1"
                        Text="Remove color change" 
                        WidthRequest="175"
                        HorizontalOptions="Start"
                        BackgroundColor="#ac99ea"
                        TextColor="#242424"
                        Clicked="OnRemoveColorButtonClicked" />
            </Grid>
        </Grid>

        <Border Grid.Column="1" >
            <Grid RowDefinitions="50, 50, 150, *, 50, 50">
                <Button Grid.Row="1"
                        Text="Choose folder"
                        WidthRequest="150"
                        BackgroundColor="#ac99ea"
                        TextColor="#242424"
                        Clicked="OnFolderSelectClicked" />

                <!-- Info-labels -->
                <VerticalStackLayout Grid.Row="2" 
                                     Padding="40" >
                    <Label Text="Folder Name:" 
                           FontSize="25" />

                    <Label x:Name="folderNameLabel" />

                    <Label Text="File Path:" 
                           FontSize="25" />

                    <Label x:Name="filePathLabel" />

                    <Label Text="Files found:"
                           FontSize="25" />

                    <Label x:Name="filesFoundLabel" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="4">
                    <Button x:Name="applyButton"
                            WidthRequest="150"
                            Text="Apply" 
                            BackgroundColor="#ac99ea"
                            TextColor="#242424"
                            Clicked="OnApplyButtonClicked" />

                    <local:ProgressBar x:Name="progressBar"
                                       WidthRequest="250"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
